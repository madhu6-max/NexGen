# AgriLink Server Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# NEVER put real secrets or API keys in this file.

# --- Environment ---
# Use "production" for production deployments.
# Production REQUIRES JWT_SECRET to be set and refuses to start without it.
NODE_ENV=development

# --- Authentication ---
# Secret key for signing and verifying JWTs.
# Generate a strong random value, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Placeholder only — replace with a real secret in .env (never commit it).
JWT_SECRET=replace-with-a-long-random-secret

# Enable demo login accounts (set to "true" for hackathon demonstrations).
# When disabled, the /api/auth/login demo-login path and /api/auth/demo-users are blocked.
ENABLE_DEMO_LOGIN=false

# --- Server ---
PORT=5000

# --- Database (SQLite) ---
# Optional override for the SQLite database file location.
# Useful for persistent disks in production (e.g. a Render volume mount).
# When empty, the server uses its default local database file.
SQLITE_DB_PATH=

# --- Frontend ---
# Production frontend origin allowed by CORS (in addition to local dev origins).
FRONTEND_URL=http://localhost:5173

# --- Payments (Razorpay) ---
# Required for online payments. Leave empty to run with Cash on Delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
